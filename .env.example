# =====================================================================
# Seller Intelligence Platform — environment variables
# Copy this file to ".env" for local use. NEVER commit a real .env file.
# =====================================================================

# ---------------------------------------------------------------------
# 1) FRONTEND (public — safe to ship to the browser)
#    Where: Netlify -> Site configuration -> Environment variables
#    Get them: Supabase -> Project Settings -> API Keys / Data API
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------
# 2) BACKEND SECRETS (private — NEVER put these in Netlify or the browser)
#    Where: Supabase -> Edge Functions -> Secrets -> "Add new secret"
#    Used by the pipeline (Phase 1+). Listed here only so you know the names.
# ---------------------------------------------------------------------
# Amazon seller data (Traject Data — Rainforest API)
RAINFOREST_API_KEY=
# Walmart seller data (Traject Data — BlueCart API)
BLUECART_API_KEY=
# Legal entity / Secretary of State filings (Cobalt Intelligence)
COBALT_API_KEY=
# Company + decision-maker enrichment (Apollo.io)
APOLLO_API_KEY=

# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge
# Functions automatically — you do not need to add them yourself.
